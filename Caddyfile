bodesmart.shop, www.bodesmart.shop {
    encode gzip
    handle /api/* {
        reverse_proxy web:8000
    }
    @admin path /admin /admin/*
    handle @admin {
        respond "No disponible" 404
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
