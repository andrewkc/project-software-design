# Copiar a .env y reemplazar los valores reales. No versionar .env.
POSTGRES_USER=bodesmart
POSTGRES_PASSWORD=cambiar-password-real
POSTGRES_DB=bodesmart
BODESMART_SECRET=cambiar-secreto-largo-y-aleatorio

# EC2 (nginx + HTTPS)
CORS_ORIGINS=https://app.bodesmart.online,https://bodesmart.shop,http://localhost:3003,http://127.0.0.1:3003
VITE_API_BASE_URL=https://api.bodesmart.online
FRONTEND_DOCKERFILE=Dockerfile
WEB_PORT=3002
WEB_CONTAINER_PORT=80

# Local con Vite, sin nginx (comentá las 4 líneas del bloque EC2 y descomentá estas):
# CORS_ORIGINS=http://localhost:5173
# VITE_API_BASE_URL=http://localhost:8000
# FRONTEND_DOCKERFILE=Dockerfile.local
# WEB_PORT=5173
# WEB_CONTAINER_PORT=5173

DB_PORT=5432
API_PORT=8000
CUSTOMER_WEB_PORT=3003
# Credencial de prueba, solo backend; no usar token de producción.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
ALLOW_SIMULATED_PAYMENT=true
