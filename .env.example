# Copiar a .env y reemplazar los valores reales. No versionar .env.
POSTGRES_USER=bodesmart
POSTGRES_PASSWORD=cambiar-password-real
POSTGRES_DB=bodesmart
BODESMART_SECRET=cambiar-secreto-largo-y-aleatorio

# Tienda de clientes y pagos de prueba (ADR-007). Nunca son cobros reales.
ALLOW_SIMULATED_PAYMENT=true
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional, solo en local: crea ofertas y un comprador demo sin borrar datos.
# BODESMART_DEMO_SEED=1

# IA de apoyo (sugerencias; la clave vive solo en el backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Opcional: ids permitidos por el selector de Foto/Voz, separados por coma.
# Siempre se incluye GEMINI_MODEL aunque no aparezca en esta lista.
# GEMINI_ALLOWED_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Opcional: v1beta es necesario para imagen/audio inline en Interactions API
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/interactions

# Código de barras: base pública sin key (Open Food Facts)
# OPEN_FOOD_FACTS_API_URL=https://world.openfoodfacts.org/api/v2/product
# OPEN_FOOD_FACTS_USER_AGENT=BodeSmart/0.1 (local-prototype)

# EC2 (nginx + HTTPS). Si defines CORS_ORIGINS, incluye también los orígenes
# locales que vayas a usar; el compose los agrega cuando esta variable no está definida.
CORS_ORIGINS=https://app.bodesmart.online,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
VITE_API_BASE_URL=https://api.bodesmart.online
FRONTEND_DOCKERFILE=Dockerfile
WEB_PORT=3002
WEB_CONTAINER_PORT=80
# customer-web sigue siendo local: el navegador llama al backend publicado en 127.0.0.1:8000.
CUSTOMER_VITE_API_BASE_URL=http://127.0.0.1:8000
CUSTOMER_DOCKERFILE=Dockerfile
CUSTOMER_PORT=5174
CUSTOMER_CONTAINER_PORT=80
ADMIN_DOCKERFILE=Dockerfile
ADMIN_PORT=5175
ADMIN_CONTAINER_PORT=80

# Local con Vite, sin nginx (comentá el bloque EC2 y descomentá estas):
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# VITE_API_BASE_URL=http://localhost:8000
# customer-web también se puede levantar aparte: cd apps/customer-web && npm run dev (puerto 5174)
# CUSTOMER_VITE_API_BASE_URL=http://localhost:8000
# CUSTOMER_DOCKERFILE=Dockerfile.local
# CUSTOMER_PORT=5174
# CUSTOMER_CONTAINER_PORT=5174
# FRONTEND_DOCKERFILE=Dockerfile.local
# WEB_PORT=5173
# WEB_CONTAINER_PORT=5173
# ADMIN_DOCKERFILE=Dockerfile.local
# ADMIN_PORT=5175
# ADMIN_CONTAINER_PORT=5175

DB_PORT=5432
API_PORT=8000
