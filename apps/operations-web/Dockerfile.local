# Local development: Vite dev server served directly, without nginx.
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# This URL runs in the browser on the host, so localhost:8000 is correct
# when the backend container publishes -p 127.0.0.1:8000:8000.
ENV VITE_API_BASE_URL=http://localhost:8000

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
