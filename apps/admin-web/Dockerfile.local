# Local development: Vite dev server served directly, without nginx.
FROM node:22-alpine

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
EXPOSE 5175

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
